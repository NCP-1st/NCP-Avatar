# CLOVA Studio (Chat Completions v3)
CLOVA_STUDIO_API_KEY=
CLOVA_STUDIO_BASE_URL=https://clovastudio.stream.ntruss.com
CLOVA_STUDIO_MODEL_VISION=HCX-005
CLOVA_STUDIO_MODEL_REASONING=HCX-007
CLOVA_STUDIO_TIMEOUT_SECONDS=30
CLOVA_STUDIO_MAX_TOKENS=1024

# CLOVA Speech Recognition / Voice 공통 Application 인증 정보
CLOVA_API_CLIENT_ID=
CLOVA_API_CLIENT_SECRET=

# CLOVA Speech Recognition (STT)
CLOVA_SPEECH_API_URL=https://naveropenapi.apigw.ntruss.com/recog/v1/stt

# CLOVA Voice (TTS)
CLOVA_VOICE_API_URL=https://naveropenapi.apigw.ntruss.com/tts-premium/v1/tts
CLOVA_VOICE_SPEAKER=nara
CLOVA_VOICE_FORMAT=mp3
CLOVA_VOICE_TIMEOUT_SECONDS=30

# Naver Object Storage (S3 호환 API)
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_OBJECT_STORAGE_BUCKET=
NCP_OBJECT_STORAGE_ENDPOINT=

# Naver Cloud DB for MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
