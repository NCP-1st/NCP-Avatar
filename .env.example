# Runtime mode: dummy | clova
MEDIARY_ADAPTER_MODE=dummy

# CLOVA Studio Chat Completions v3
CLOVA_STUDIO_API_KEY=
CLOVA_STUDIO_BASE_URL=https://clovastudio.stream.ntruss.com
CLOVA_STUDIO_MODEL_VISION=HCX-005
CLOVA_STUDIO_MODEL_REASONING=HCX-007
CLOVA_STUDIO_TIMEOUT_SECONDS=30
CLOVA_STUDIO_MAX_TOKENS=1024

# Short audio (CSR adapter currently used by /inputs)
CLOVA_SPEECH_CLIENT_ID=
CLOVA_SPEECH_CLIENT_SECRET=

# Long-form CLOVA Speech (future adapter)
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET_KEY=

# CLOVA Voice
CLOVA_VOICE_API_URL=https://naveropenapi.apigw.ntruss.com/tts-premium/v1/tts
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=

# Experimental Hugging Face talking-avatar adapter
HF_TOKEN=
HF_AVATAR_PROFILE=sadtalker
HF_AVATAR_SPACE_ID=nomad0884/SadTalker
HF_AVATAR_API_NAME=/predict
HF_AVATAR_TIMEOUT_SECONDS=600
HF_AVATAR_IMAGE_PATH=backend/character/char_1.png

# Naver Object Storage
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_OBJECT_STORAGE_BUCKET=
NCP_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com

# Counsel: which retriever finds past diaries — sql (lexical) | vector (embedding)
COUNSEL_DIARY_BACKEND=vector

# --- 상담: 과거 일기 참조 임계값 -------------------------------------------
# 주석을 풀면 코드 기본값 대신 이 값이 쓰인다. 서버 재시작만 하면 반영된다.
#
# [벡터 검색] COUNSEL_DIARY_BACKEND=vector 일 때 쓰인다 (코사인 유사도 0~1).
#   올리면  -> 덜 걸리지만 확실한 것만 (없는 과거를 지어낼 위험 감소)
#   내리면  -> 자주 걸리지만 엉뚱한 일기가 섞임

#DIARY_VEC_MIN_SCORE=0.52      # 이 점수 미만 후보는 버린다
#DIARY_VEC_STRONG_SCORE=0.52   # 최상위가 이 미만이면 그 턴은 아예 참조 안 함

# [어휘 검색] COUNSEL_DIARY_BACKEND=sql 일 때 쓰인다 (낱말 겹침 비율 0~1).
# 분포가 전혀 다르므로 위 값과 같은 숫자를 쓰면 안 된다.
#DIARY_MIN_SCORE=0.5
#DIARY_MIN_MATCH_TOKENS=1
#DIARY_MIN_HEADLINE_TOKENS=1
#DIARY_STRONG_SCORE=0.7

# PostgreSQL (Naver Cloud DB for PostgreSQL or compatible)
DB_HOST=
DB_PORT=5432
DB_NAME=mediary
DB_USER=
DB_PASSWORD=
# Optional full async URL; overrides DB_* when set
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/mediary
